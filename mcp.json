{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "easygerber": {
      "type": "streamable-http",
      "url": "https://www.easygerber.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["boards:read", "boards:write", "boards:generate", "boards:export", "offline_access"]
          }
        }
      }
    }
  }
}
